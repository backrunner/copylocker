{
  "name": "@copylocker/docs",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "description": "CopyLocker documentation site (svedocs on Cloudflare Pages)",
  "scripts": {
    "dev": "svedocs dev",
    "build": "svedocs build --mode edge",
    "check": "svelte-kit sync && tsc -p tsconfig.json --noEmit",
    "preview": "wrangler pages dev .svelte-kit/cloudflare",
    "deploy": "svedocs deploy cloudflare -- --project-name copylocker-docs"
  },
  "dependencies": {
    "@sveltejs/adapter-cloudflare": "^7.2.8",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.60.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.0",
    "svelte": "^5.55.7",
    "svedocs": "0.1.0",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.13",
    "wrangler": "^4.92.0"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "svedocs-cli": "0.1.0",
    "typescript": "^6.0.3"
  }
}
