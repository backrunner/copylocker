{
  "name": "@copylocker/guard",
  "version": "0.1.0",
  "description": "CopyLocker runtime integrity guard — build-artifact self-verification whose result feeds key derivation (M4).",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./diagnose": {
      "types": "./dist/diagnose.d.ts",
      "import": "./dist/diagnose.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "npm run build && npm test"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/copylocker/copylocker.git",
    "directory": "packages/guard"
  }
}
