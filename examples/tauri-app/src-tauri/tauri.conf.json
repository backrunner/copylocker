{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CopyLocker Native Lab",
  "version": "0.1.0",
  "identifier": "dev.copylocker.example.tauri",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CopyLocker Native Lab",
        "width": 1024,
        "height": 720,
        "minWidth": 640,
        "minHeight": 600,
        "devtools": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost",
      "dangerousDisableAssetCspModification": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "../../assets/copylocker-seal.ico",
      "../../assets/copylocker-seal.icns"
    ]
  }
}
